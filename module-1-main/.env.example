# Copy this file to .env and fill in your values

# Flask
SECRET_KEY=your-super-secret-flask-key

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/dbname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/datavault

# News API — get a FREE key at https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# (optional) Streamlit frontend base URL for the Flask API
API_BASE=http://localhost:5000/api
